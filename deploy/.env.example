# LoomyProxy 服务器环境变量（复制为 .env 后修改；不要提交真实值）
#
# 监听：容器内固定 0.0.0.0:8787，宿主机只绑 127.0.0.1，由 Nginx 反代
LOOMY_PROXY_HOST=0.0.0.0
LOOMY_PROXY_PORT=8787

# 管理台密码：对外暴露前必须设置（留空＝仅本机/容器内可访问）
LOOMY_PROXY_ADMIN_PASSWORD=

# 上游与账号服务
LOOMY_PROXY_UPSTREAM_BASE=https://loomyad.xunfei.cn/api/v1
LOOMY_PROXY_ACCOUNT_BASE=https://account.xfinfr.com

# 讯飞账号 AK/SK 来源：挂进容器的加密 .env.prod（0600，绝不入库）
LOOMY_PROXY_ENV_FILE=/app/secrets/.env.prod

# 日志级别：debug / info / warn / error
LOOMY_PROXY_LOG_LEVEL=info

# 建号后自动领新号权益（新手任务 + 池内邀请码）；不需要就设为 false
LOOMY_PROXY_LOGIN_AUTO_BONUS=true
LOOMY_PROXY_LOGIN_AUTO_INVITE=true

# 镜像模式下的 tag（源码模式忽略）
LOOMY_PROXY_TAG=latest
